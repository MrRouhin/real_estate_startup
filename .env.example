# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key   # server only

# Where the app runs (used in emails / redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments: "simulated" lets you test the whole booking flow without Razorpay.
# Switch to "razorpay" and add test keys before showing real buyers. Never use "simulated" in production.
PAYMENTS_MODE=simulated
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Live updates through Supabase Realtime ("on" or "off")
NEXT_PUBLIC_REALTIME=on

# Optional: password used by `npm run seed` for every demo login
SEED_PASSWORD=Plotline@2026
